# Copy this file to .env and fill in your values. Never commit .env.

# Google Gemini API key (get one from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model ID (selected after benchmarking Flash-family models on the hard sample docs)
GEMINI_MODEL=gemini-3.5-flash-lite

# Path to the local sample pack folder (absolute or relative to repo root)
SAMPLE_PACK_DIR=Sample Pack

# Maximum accepted upload size in megabytes for the FastAPI /extract endpoint
MAX_UPLOAD_SIZE_MB=20

# Upstream Gemini API timeout (seconds), transient retry count, and backoff base (seconds)
API_TIMEOUT_SECONDS=45
API_MAX_RETRIES=2
API_BACKOFF_BASE_SECONDS=1.0
